{
  "name": "puzzle-getaway-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Level forge for Puzzle Getaway: schema, validators, solvers, generators.",
  "scripts": {
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "validate": "tsx src/validate.ts",
    "gen:sort": "tsx scripts/gen-sort.ts",
    "gen:sort-golden": "tsx scripts/gen-sort-golden.ts",
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
